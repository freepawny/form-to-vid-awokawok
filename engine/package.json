{
  "name": "three-remotion-video-generator",
  "version": "1.0.0",
  "description": "3D animated video generator built with Three.js, React Three Fiber, and Remotion (captions, audio, and rendering)",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "start": "remotion studio",
    "render": "remotion render MainVideo out/video.mp4",
    "render:vertical": "remotion render VerticalShort out/short.mp4",
    "typecheck": "tsc --noEmit",
    "upgrade": "remotion upgrade",
    "project:new": "node scripts/project-manager.mjs new",
    "project:sync": "node scripts/project-manager.mjs sync",
    "project:dev": "node scripts/project-manager.mjs dev",
    "project:render": "node scripts/project-manager.mjs render",
    "project:render:vertical": "node scripts/project-manager.mjs render --vertical",
    "project:render:landscape": "node scripts/project-manager.mjs render --landscape"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@remotion/captions": "4.0.541",
    "@remotion/cli": "4.0.541",
    "@remotion/media": "4.0.541",
    "@remotion/media-utils": "4.0.541",
    "@remotion/sfx": "4.0.541",
    "@remotion/three": "4.0.541",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.541",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "typescript": "^5.9.3"
  }
}
